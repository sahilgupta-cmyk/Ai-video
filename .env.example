# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Encryption key for API keys stored in database
ENCRYPTION_KEY="your-encryption-key-generate-with-openssl-rand-base64-32"

# Cron job secret (used to authenticate the Vercel cron endpoint)
CRON_SECRET="your-cron-secret-generate-with-openssl-rand-base64-32"
